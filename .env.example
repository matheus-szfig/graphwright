# Root env for docker compose itself (copied to .env by `make setup-env`).

# The only published port: nginx → http://localhost:${HTTP_PORT}
HTTP_PORT=8080

# Graph builder upstreams. Defaults point at the containers of the `builder`
# profile; `make builder-local NGINX=1` re-points them at the host so a headed
# builder on your machine is reachable at http://localhost:8080/builder/.
BUILDER_API_UPSTREAM=builder-api:8765
BUILDER_WEB_UPSTREAM=builder-web:5174
