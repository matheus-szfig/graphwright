# Runs API environment.
#
# Committed template. `make env:setup` copies it to .env.docker (docker compose)
# and `make env:local` to .env (host runs, loopback hosts). Defaults target
# the compose network (service-name hostnames).

# dev | test | prod. Outside dev/test the dev API key and the default worker
# password are refused.
ENV=dev

# --- Database ---------------------------------------------------------------
# The schema owner: the API reads/writes runs and runs the migrations.
POSTGRES_DSN=postgresql://graphwright:graphwright@postgres:5432/graphwright
# Password for the worker's least-privilege role, set at migrate time. Must
# match the password in engine/.env*'s POSTGRES_DSN.
DB_PASSWORD_WORKER=graphwright_worker

# --- Queue & progress -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth -------------------------------------------------------------------
# Comma-separated id:secret pairs; callers send the secret as X-API-Key and the
# id is recorded as run.requested_by. Generate real secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=dev:dev-only-change-me

# --- Graphs -----------------------------------------------------------------
# Empty = the engine's graphs/ (the image ships them at /app/engine/graphs).
GRAPHS_DIR=
# Modules that register shapers / portal aliases (same list the worker loads).
PLUGINS=

# --- Failure evidence (read-only here; the worker writes it) ------------------
# Same S3 store and bucket prefix as engine/.env* — the API streams artifacts out
# of <S3_BUCKET_PREFIX>-<EVIDENCE_BUCKET_SUFFIX>.
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=graphwright
S3_SECRET_KEY=graphwright-dev-only
S3_REGION=us-east-1
S3_BUCKET_PREFIX=graphwright-dev
