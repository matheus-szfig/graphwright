# Builder API environment (host runs read builder-api/.env — `make env:local`).
# The builder uses the engine's settings for credentials, plugins and the browser.

# Credentials for sessions and request tests: the `demo` reference is demo-site's
# fake account (same as engine/.env.example). Replace for real sites.
CREDENTIAL_PROVIDER=env
GW_CRED_DEMO_USERNAME=demo
GW_CRED_DEMO_PASSWORD=demo-password
GW_CRED_DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
GW_CRED_DEMO_RELAY_TOKEN=demo-relay-token
GW_CRED_DEMO_PORTAL=acme-records

PLUGINS=
BROWSER_DEFAULT_PROFILE=win11_chrome_1920

# Optional server-side AI keys. Alternatively connect from the AI panel (memory only).
# Export these when starting builder:local; never put provider keys in graph inputs.
# BUILDER_AI_OPENAI_KEY=
# BUILDER_AI_ANTHROPIC_KEY=
# BUILDER_AI_DOCS_DIR=/absolute/path/to/docs/engine-yaml
BUILDER_AI_CONNECTION_TTL_S=3600
BUILDER_AI_MAX_ROUNDS=8
# 0: auto (Claude 32000, bounded by model metadata; OpenAI 4096).
BUILDER_AI_MAX_OUTPUT_TOKENS=0
# Output-limit recovery may grow the budget up to this and the model's cap.
BUILDER_AI_OUTPUT_TOKEN_CEILING=128000
# No turn deadline by default; positive seconds opt into a deadline (e.g. 7200).
BUILDER_AI_TIMEOUT_S=0
# Character budgets: compact initial context, individual result pages, active model request.
BUILDER_AI_CONTEXT_CHARS=16000
BUILDER_AI_TOOL_PAGE_CHARS=6000
BUILDER_AI_REQUEST_CHARS=96000
# Selector sees a masked resource catalog only; failure falls back to local relevance.
# Pre-select context with a small model before each large turn (off: the main model explores).
BUILDER_AI_TRIAGE_AUTO=false
BUILDER_AI_TRIAGE_TIMEOUT_S=20
BUILDER_AI_TRIAGE_ANTHROPIC_MODEL=claude-haiku-5-5
BUILDER_AI_TRIAGE_OPENAI_MODEL=gpt-5-nano
# Main model picked at connect time when the key's catalog has it; switch it from the chat's model badge.
BUILDER_AI_DEFAULT_ANTHROPIC_MODEL=claude-opus-5-5
BUILDER_AI_DEFAULT_OPENAI_MODEL=gpt-5
