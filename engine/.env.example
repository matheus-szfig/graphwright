# Engine / worker environment.
#
# Committed template. `make env:setup` copies it to:
#   .env.docker  (default — used by docker compose, gitignored)
#   .env         (`make env:local` — localhost hosts, for running on the host)
# Every variable is declared in src/graphwright/config.py.

# --- Queue & progress ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Database -----------------------------------------------------------------
# The worker's least-privilege role (api/alembic creates it): reads runs, writes
# their outcome, events and artifacts — nothing else.
POSTGRES_DSN=postgresql://graphwright_worker:graphwright_worker@postgres:5432/graphwright

# --- Object storage (S3-compatible; compose runs RustFS) ----------------------
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=graphwright
S3_SECRET_KEY=graphwright-dev-only
S3_REGION=us-east-1
S3_BUCKET_PREFIX=graphwright-dev

# --- Failure evidence -----------------------------------------------------------
# failure = failed runs + `terminal: failure` outcomes · always · never
EVIDENCE_ON=failure
EVIDENCE_BUCKET_SUFFIX=evidence
EVIDENCE_SCREENSHOT=true
EVIDENCE_FULL_PAGE=true
EVIDENCE_MAX_BYTES=5000000

# --- Graphs & plugins ---------------------------------------------------------
# Empty = <engine>/graphs (what the image ships).
GRAPHS_DIR=
# Comma-separated modules that register shapers / portal aliases / credential providers.
PLUGINS=

# --- Credentials --------------------------------------------------------------
# none | file | env | http. A run names its credential by reference; the provider
# turns the reference into values when the run starts (TOTP codes: when used).
CREDENTIAL_PROVIDER=env
# file: YAML/JSON ref → {kind, portal, values, totp_secret} (e.g. a mounted secret)
CREDENTIALS_FILE=
# env: GW_CRED_<REF>_<FIELD>=value. The `demo` credential below is demo-site's
# fake account — the example graphs log in with it. Replace for real use.
CREDENTIALS_ENV_PREFIX=GW_CRED_
GW_CRED_DEMO_USERNAME=demo
GW_CRED_DEMO_PASSWORD=demo-password
GW_CRED_DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
GW_CRED_DEMO_RELAY_TOKEN=demo-relay-token
# Pins the credential to graphs whose `portal` is acme-records; others are refused.
GW_CRED_DEMO_PORTAL=acme-records
# http: a lease service (see src/graphwright/credentials/http.py for the contract)
CREDENTIALS_HTTP_URL=
CREDENTIALS_HTTP_KEY_ID=
CREDENTIALS_HTTP_KEY=
CREDENTIALS_HTTP_CLIENT_CERT=
CREDENTIALS_HTTP_CA_BUNDLE=

# --- Graph requests -------------------------------------------------------------
# Empty = any host. Otherwise a comma-separated allowlist (exact host, or
# ".example.com" for a suffix) of what graph requests may call.
REQUESTS_ALLOWED_HOSTS=
REQUESTS_DEFAULT_TIMEOUT_S=10

# --- Browser --------------------------------------------------------------------
# headless: "true" | "false" (visible window) | "new" (same as true)
BROWSER_HEADLESS=true
BROWSER_DEFAULT_PROFILE=win11_chrome_1920
BROWSER_TELEMETRY_BLOCK_ENABLED=false
BROWSER_SESSION_BUCKET_SUFFIX=sessions
# Dev escape hatch for self-signed staging certs. Authenticated runs refuse to
# start while it is on. Never true in production.
BROWSER_IGNORE_HTTPS_ERRORS=false
